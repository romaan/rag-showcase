# App
APP_ENV=dev
LOG_LEVEL=INFO

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=rag
PG_USER=rag
PG_PASSWORD=rag

# Embeddings: "local" (sentence-transformers) or "openai"
EMBEDDINGS_PROVIDER=ollama
OPENAI_API_KEY=

# LLM Provider: "openai" or "mock"
LLM_PROVIDER=ollama
OPENAI_MODEL=gpt-4o-mini

# RAG settings
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5

# Optional: tracing (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rag-showcase
